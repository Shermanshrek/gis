# Скопируйте в .env и заполните. .env в .gitignore.
# Значения читаются из окружения в src/main/resources/application.yml.

# Base64-строка, декодируется в ключ >= 32 байт (HS256). Пример генерации:
#   openssl rand -base64 48
JWT_SECRET=

# Необязательные — есть значения по умолчанию в application.yml
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

DB_URL=jdbc:postgresql://localhost:5432/gis
DB_USERNAME=postgres
DB_PASSWORD=

SERVER_PORT=8080
JPA_DDL_AUTO=update
